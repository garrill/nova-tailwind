{
    "identifier": "garrill.tailwind",
    "name": "Tailwind",
    "organization": "Garrill",
    "description": "Autocompletion for Tailwind CSS v4 utility classes and variants.",
    "version": "1.2",
    "categories": ["completions", "sidebars", "languages"],

    "repository": "https://github.com/garrill/nova-tailwind",
    "bugs": "https://github.com/garrill/nova-tailwind/issues",

    "main": "main.js",

    "activationEvents": [
        "onLanguage:html",
        "onLanguage:html+erb",
        "onLanguage:html+eex",
        "onLanguage:haml",
        "onLanguage:php",
        "onLanguage:blade",
        "onLanguage:twig",
        "onLanguage:liquid-html",
        "onLanguage:jade",
        "onLanguage:pug",
        "onLanguage:markdown",
        "onLanguage:vue",
        "onLanguage:svelte",
        "onLanguage:astro",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onLanguage:jsx",
        "onLanguage:tsx",
        "onLanguage:css",
        "onLanguage:sass",
        "onLanguage:scss"
    ],

    "configWorkspace": [
        {
            "key": "garrill.tailwind.themeEntryPath",
            "title": "Custom theme entry CSS file",
            "description": "Path to the CSS file containing your project's @theme/@utility customizations (e.g. src/app.css). Local @import statements from this file are followed too. Leave blank to use only Tailwind's default theme.",
            "type": "path",
            "relative": true,
            "allowFiles": true,
            "allowFolders": false,
            "filetype": ["css"],
            "default": ""
        },
        {
            "key": "garrill.tailwind.suppressDefaultColors",
            "title": "Suppress default Tailwind colors",
            "description": "Only show colors defined in your own theme CSS's @theme block — hides Tailwind's default color palette (red, blue, grey, etc.) from completions entirely. Has no effect unless a custom theme entry CSS file is set above.",
            "type": "boolean",
            "default": false
        },
        {
            "key": "garrill.tailwind.enableHoverPreview",
            "title": "Enable hover preview",
            "description": "Show the resolved CSS for a Tailwind class when hovering over it. On by default; turn it off here for any project that doesn't need it. Requires Node.js and npm — the first time it runs, the extension installs Tailwind's own language server (@tailwindcss/language-server) via npm, which needs network access. Nova only lets one language server provide hovers per language: if Nova's built-in HTML/CSS Language Server has hover enabled, Tailwind's hovers won't show. To fix it, go to Nova → Settings → Languages → (language), click the ⓘ next to that server, and turn off hover in its Features tab.",
            "type": "boolean",
            "default": true
        }
    ],

    "entitlements": {
        "filesystem": "readwrite",
        "clipboard": true,
        "process": true,
        "requests": true
    },

    "commands": {
        "command-palette": [
            {
                "title": "Tailwind: Filter Sidebar",
                "command": "garrill.tailwind.sidebar.filter"
            }
        ]
    },

    "sidebars": [
        {
            "id": "garrill.tailwind.sidebar",
            "name": "Tailwind",
            "smallImage": "sidebar-small",
            "largeImage": "sidebar-large",
            "sections": [
                {
                    "id": "garrill.tailwind.documentation",
                    "name": "Tailwind Documentation",
                    "placeholderText": "No matching Tailwind classes.",
                    "headerCommands": [
                        {
                            "title": "Filter",
                            "image": "filter",
                            "tooltip": "Filter by class name or CSS property",
                            "command": "garrill.tailwind.sidebar.filter"
                        },
                        {
                            "title": "Expand",
                            "image": "__builtin.add",
                            "tooltip": "Expand All",
                            "command": "garrill.tailwind.sidebar.expandAll"
                        },
                        {
                            "title": "Collapse",
                            "image": "__builtin.remove",
                            "tooltip": "Collapse All",
                            "command": "garrill.tailwind.sidebar.collapseAll"
                        }
                    ],
                    "contextCommands": [
                        {
                            "title": "Open in Tailwind Docs",
                            "command": "garrill.tailwind.sidebar.openDocs",
                            "when": "viewItem == 'docs' || viewItem == 'docs+copy'"
                        },
                        {
                            "title": "Copy Class Name",
                            "command": "garrill.tailwind.sidebar.copyClassName",
                            "when": "viewItem == 'copy' || viewItem == 'docs+copy'"
                        },
                        {
                            "title": "Copy CSS",
                            "command": "garrill.tailwind.sidebar.copyCss",
                            "when": "viewItem == 'copy' || viewItem == 'docs+copy'"
                        },
                        {
                            "title": "Clear Filter",
                            "image": "__builtin.remove",
                            "command": "garrill.tailwind.sidebar.clearFilter",
                            "when": "viewItem == 'filter-status'"
                        }
                    ]
                }
            ]
        }
    ]
}
